# Variante de l'expérience B : MAUVAIS ordre volontaire.
FROM python:3.12.7-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

# Tout est copié d'un coup, avant l'installation : toute modification d'app.py
# invalide cette couche, donc le pip install qui suit est rejoué à chaque build.
COPY . ./
RUN pip install --no-cache-dir -r requirements.txt

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app

USER 10001

EXPOSE 8000

CMD ["python", "app.py"]
